#!/bin/sh
set -eu

run_worktree_fleet() {
  if [ -n "${WORKTREE_FLEET_BIN:-}" ]; then
    case "${WORKTREE_FLEET_BIN}" in
      *.js) exec node "${WORKTREE_FLEET_BIN}" "$@" ;;
    esac
    exec "${WORKTREE_FLEET_BIN}" "$@"
  fi

  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/dist/cli/index.js" ]; then
    exec node "${CLAUDE_PLUGIN_ROOT}/dist/cli/index.js" "$@"
  fi

  if command -v worktree-fleet >/dev/null 2>&1; then
    exec worktree-fleet "$@"
  fi

  exec npm exec --yes --package @mgdickinson/worktree-fleet@latest -- worktree-fleet "$@"
}

run_worktree_fleet sidecar run --agent claude-code
