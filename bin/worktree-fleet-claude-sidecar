#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ -x "${root}/plugins/worktree-fleet-claude/bin/worktree-fleet-claude-sidecar" ]; then
  exec "${root}/plugins/worktree-fleet-claude/bin/worktree-fleet-claude-sidecar" "$@"
fi

if [ -x "${root}/bin/worktree-fleet" ]; then
  exec "${root}/bin/worktree-fleet" sidecar run --agent claude-code "$@"
fi

exec npm exec --yes --package @mgdickinson/worktree-fleet@latest -- worktree-fleet sidecar run --agent claude-code "$@"
