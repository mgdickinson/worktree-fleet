#!/bin/sh
set -eu

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/dist/cli/index.js" ]; then
  exec node "${CLAUDE_PLUGIN_ROOT}/dist/cli/index.js" "$@"
fi

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -f "${root}/dist/cli/index.js" ]; then
  exec node "${root}/dist/cli/index.js" "$@"
fi

exec npm exec --yes --package @mgdickinson/worktree-fleet@latest -- worktree-fleet "$@"
