{
  "name": "@mgdickinson/worktree-fleet",
  "version": "0.1.7",
  "description": "Local coordination for mixed AI coding sessions across git worktrees.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Matthew Dickinson",
  "homepage": "https://github.com/mgdickinson/worktree-fleet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgdickinson/worktree-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/mgdickinson/worktree-fleet/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "git",
    "worktree",
    "ai-agents",
    "coordination"
  ],
  "type": "module",
  "bin": {
    "worktree-fleet": "dist/cli/index.js",
    "fleet": "dist/cli/fleet.js"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    "bin",
    "dist",
    "plugins",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js dist/cli/fleet.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3"
  }
}
